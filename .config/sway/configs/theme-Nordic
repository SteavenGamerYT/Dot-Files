font pango:Roboto Regular 12

set $gnome-schema org.gnome.desktop.interface
exec_always {
    gsettings set $gnome-schema gtk-theme 'Nordic'
    gsettings set $gnome-schema icon-theme 'Papirus-Dark'
    gsettings set $gnome-schema cursor-theme 'WhiteSur-cursors'
    gsettings set $gnome-schema cursor-size 24
    gsettings set $gnome-schema color-scheme 'prefer-dark'
    gsettings set $gnome-schema font-name 'Roboto Regular 12'
}
seat seat0 xcursor_theme WhiteSur-cursors 24

# Color scheme (Nordic Palette)
set $nord0 #2E3440
set $nord1 #3B4252
set $nord2 #434C5E
set $nord3 #4C566A
set $nord4 #D8DEE9
set $nord5 #E5E9F0
set $nord6 #ECEFF4
set $nord7 #8FBCBB
set $nord8 #88C0D0
set $nord9 #81A1C1
set $nord10 #5E81AC
set $nord11 #BF616A
set $nord12 #D08770
set $nord13 #EBCB8B
set $nord14 #A3BE8C
set $nord15 #B48EAD

# class                 border  bground text    indicator child_border
client.focused           $nord8  $nord0  $nord6  $nord8    $nord8
client.focused_inactive  $nord3  $nord0  $nord4  $nord3    $nord3
client.unfocused         $nord1  $nord0  $nord4  $nord1    $nord1
client.urgent            $nord11 $nord0  $nord6  $nord11   $nord11
client.placeholder       $nord1  $nord0  $nord4  $nord1    $nord1
client.background        $nord0